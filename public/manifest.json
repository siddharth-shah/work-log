{
  "manifest_version": 3,
  "name": "Timebase — Project Time Tracker",
  "short_name": "Timebase",
  "version": "1.0.0",
  "description": "Track time across projects with private browser storage and portable JSON backups.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Timebase",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
